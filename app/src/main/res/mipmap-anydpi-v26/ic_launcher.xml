<?xml version="1.0" encoding="utf-8"?>
<!-- Stays in mipmap-anydpi-v26 even though minSdk is 26 and lint's ObsoleteSdkInt
     says to merge it into mipmap-anydpi: AGP 8.7's resource merger silently drops
     a bare anydpi mipmap folder, and the build then fails with
     "resource mipmap/ic_launcher not found". aapt2 compiles it fine on its own,
     so the problem is the merger, not the qualifier. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
